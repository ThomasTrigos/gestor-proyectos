DEBUG=True
SECRET_KEY=your-secret-key-here
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gestor
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# INTEGRACIÓN CON MÚLTIPLES PROVEEDORES DE INTELIGENCIA ARTIFICIAL (LLMs)
# ==============================================================================
# Puedes cargar las APIs de Gemini, Grok, Claude y OpenAI por variables de entorno
# o directamente desde la interfaz web (Configuración > Inteligencia Artificial).
# Si no hay ninguna clave cargada o no hay internet, el sistema funciona de modo
# 100% autónomo con el motor NLP local integrado.

# 1. Google Gemini (API oficial: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. xAI Grok (API oficial: https://x.ai/api)
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# 3. Anthropic Claude (API oficial: https://console.anthropic.com/)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 4. OpenAI (API oficial: https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
